# Copy to .env and fill in. Every variable the service reads is listed here.
# All of them are optional except where noted — with none set, the API still
# analyses code; AI actions and report history are simply unavailable, and
# /api/health says so explicitly.

# --- Runtime ---
ENVIRONMENT=development          # development | production
LOG_LEVEL=INFO

# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- AI (optional) ---
# Get a key from https://aistudio.google.com/apikey
# Leave blank to run without AI: analysis works, AI actions are disabled and
# the UI states the reason rather than hiding the buttons.
GEMINI_API_KEY=
# Free-tier quota is per model, not per key. If you get 429s, switching model
# is usually faster than waiting for the reset. Flash models are recommended:
# pro models are generally not available on the free tier.
GEMINI_MODEL=gemini-3.6-flash
AI_TIMEOUT_SECONDS=90

# --- Database (optional) ---
# Postgres connection string. Must use the asyncpg driver.
# Neon: postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME
# Without this, reports are held in memory and lost on restart.
DATABASE_URL=

# --- GitHub (optional) ---
# Anonymous requests are limited to 60/hour per IP; a token raises that to
# 5000/hour. A fine-grained token with public read access is sufficient.
#
# This matters more than it used to: commit-history enrichment spends one
# request per file carrying a finding, so an anonymous server can exhaust its
# whole hourly budget in a couple of analyses. Without a token the Activity tab
# degrades to "partial" and states why.
GITHUB_TOKEN=

# --- Sign-in (optional; the three below are required together) ---
# Without these the product still analyses public repositories; sign-in is
# reported as unconfigured by /api/health, naming exactly what is missing.
#
# Sign-in buys three things: reports become owned, so the history listing stops
# showing everyone's analyses to everyone; analyses spend the signed-in user's
# 5000/hour GitHub budget rather than the server's shared 60; and private
# repositories become analysable if the user separately grants `repo`.
#
# DATABASE_URL is also required — accounts have to be stored somewhere.
#
# Create an OAuth app at https://github.com/settings/developers with callback
# URL <frontend-origin>/api/auth/github/callback
GITHUB_CLIENT_ID=
# The client *secret* belongs to the frontend, which performs the code exchange
# server-side so it never reaches a browser. It is deliberately not read here.

# Authenticates the frontend server to this API when it swaps a GitHub token
# for a session. Not a user credential.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_SECRET=

# Encrypts stored GitHub tokens at rest. Separate from any session secret so
# the two rotate independently; rotating it signs everyone out rather than
# corrupting anything.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# SESSION_TTL_DAYS=30

# --- Limits (optional; defaults shown) ---
# MAX_ARCHIVE_BYTES=262144000
# MAX_EXTRACTED_BYTES=524288000
# MAX_FILE_BYTES=8388608
# MAX_FILE_COUNT=30000
# MAX_COMPRESSION_RATIO=20
# ANALYSIS_TIMEOUT_SECONDS=180
